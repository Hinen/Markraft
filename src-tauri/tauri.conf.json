{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markraft",
  "version": "0.1.0",
  "identifier": "io.hinen.markraft",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Markraft",
        "width": 1100,
        "height": 780,
        "minWidth": 640,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Local text and rich Markdown editor",
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "txt", "json", "yaml", "yml", "xml"],
        "name": "Markraft.Document",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt",
      "../DEPENDENCIES.md": "DEPENDENCIES.md",
      "../LICENSE_REVIEW.md": "LICENSE_REVIEW.md",
      "../QA_REGRESSIONS.md": "QA_REGRESSIONS.md",
      "../README.md": "README.md"
    }
  }
}
