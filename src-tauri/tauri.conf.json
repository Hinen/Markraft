{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markraft",
  "version": "0.0.5",
  "identifier": "io.hinen.markraft",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Markraft",
        "width": 1100,
        "height": 780,
        "minWidth": 640,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Text and rich Markdown editor",
    "fileAssociations": [
      {
        "ext": [
          "bash",
          "cfg",
          "cjs",
          "code-workspace",
          "conf",
          "config",
          "css",
          "csv",
          "cts",
          "diff",
          "env",
          "htm",
          "html",
          "ini",
          "js",
          "json",
          "jsonc",
          "jsx",
          "log",
          "lst",
          "markdown",
          "md",
          "mjs",
          "mts",
          "patch",
          "properties",
          "ps1",
          "psd1",
          "psm1",
          "py",
          "pyi",
          "pyw",
          "sh",
          "sql",
          "svg",
          "tab",
          "text",
          "toml",
          "ts",
          "tsv",
          "tsx",
          "txt",
          "xml",
          "xsd",
          "xsl",
          "yaml",
          "yml",
          "zsh"
        ],
        "name": "Markraft.Document",
        "role": "Editor",
        "rank": "Alternate",
        "contentTypes": [
          "public.text",
          "public.mpeg-2-transport-stream",
          "public.avchd-mpeg-2-transport-stream",
          "io.hinen.markraft.imported.cfg",
          "io.hinen.markraft.imported.cjs",
          "io.hinen.markraft.imported.code-workspace",
          "io.hinen.markraft.imported.conf",
          "io.hinen.markraft.imported.config",
          "io.hinen.markraft.imported.cts",
          "io.hinen.markraft.imported.env",
          "io.hinen.markraft.imported.ini",
          "io.hinen.markraft.imported.js",
          "io.hinen.markraft.imported.jsonc",
          "io.hinen.markraft.imported.jsx",
          "io.hinen.markraft.imported.log",
          "io.hinen.markraft.imported.lst",
          "io.hinen.markraft.imported.markdown",
          "io.hinen.markraft.imported.md",
          "io.hinen.markraft.imported.mjs",
          "io.hinen.markraft.imported.mts",
          "io.hinen.markraft.imported.properties",
          "io.hinen.markraft.imported.ps1",
          "io.hinen.markraft.imported.psd1",
          "io.hinen.markraft.imported.psm1",
          "io.hinen.markraft.imported.pyi",
          "io.hinen.markraft.imported.pyw",
          "io.hinen.markraft.imported.sql",
          "io.hinen.markraft.imported.tab",
          "io.hinen.markraft.imported.ts",
          "io.hinen.markraft.imported.tsx",
          "io.hinen.markraft.imported.xsd",
          "io.hinen.markraft.imported.xsl"
        ]
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "displayLanguageSelector": false,
        "installerHooks": "windows/hooks.nsh",
        "languages": [
          "English",
          "Korean",
          "Japanese"
        ],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "windows/branding/header.bmp",
        "sidebarImage": "windows/branding/sidebar.bmp",
        "uninstallerHeaderImage": "windows/branding/header.bmp"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "LICENSE",
      "../CODE_SIGNING_POLICY.md": "CODE_SIGNING_POLICY.md",
      "../PRIVACY.md": "PRIVACY.md",
      "../DISTRIBUTION_COMPONENTS.md": "DISTRIBUTION_COMPONENTS.md",
      "../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt",
      "../DEPENDENCIES.md": "DEPENDENCIES.md",
      "../DEPENDENCY_REVIEW.md": "DEPENDENCY_REVIEW.md",
      "../QA_REGRESSIONS.md": "QA_REGRESSIONS.md",
      "../README.md": "README.md",
      "../SYNTAX_SUPPORT.md": "SYNTAX_SUPPORT.md",
      "../QA.md": "QA.md",
      "../assets/icon.svg": "assets/icon.svg",
      "../assets/screenshots/workspace.png": "assets/screenshots/workspace.png"
    },
    "copyright": "Markraft"
  }
}
